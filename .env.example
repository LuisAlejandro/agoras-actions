# Copy to secrets.env for local functional testing (see test.sh / make functional-test).
# GitHub Action inputs use kebab-case in action.yml; test.sh maps these env vars.

# Optional: isolate Agoras credential storage during refresh-credentials testing
# AGORAS_STORAGE_DIR=/tmp/agoras-storage

# Required for every run (test.sh currently hardcodes network=x, action=post)
NETWORK=x
ACTION=post

# Post content
STATUS_TEXT=
STATUS_LINK=
STATUS_IMAGE_URL_1=
STATUS_IMAGE_URL_2=
STATUS_IMAGE_URL_3=
STATUS_IMAGE_URL_4=

# Optional feed/lookback params (passed by test.sh; schedule/feed actions are not supported by the Action)
FEED_URL=
MAX_COUNT=
POST_LOOKBACK=
MAX_POST_AGE=

# Post IDs (like, share, delete)
TWEET_ID=
FACEBOOK_POST_ID=
INSTAGRAM_POST_ID=
LINKEDIN_POST_ID=

# X (Twitter) — Agoras still uses TWITTER_* env names
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_OAUTH_TOKEN=
TWITTER_OAUTH_SECRET=

# Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REFRESH_TOKEN=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_OBJECT_ID=
FACEBOOK_PROFILE_ID=
FACEBOOK_APP_ID=

# Instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_OBJECT_ID=

# LinkedIn (standard apps often need LINKEDIN_ACCESS_TOKEN instead of refresh)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_OBJECT_ID=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_SERVER_NAME=
DISCORD_CHANNEL_NAME=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_USERNAME=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REFRESH_TOKEN=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TEMPLATE_COMPONENTS=

# Credential refresh → GitHub secrets (action: refresh-credentials)
GITHUB_SECRET_UPDATE_TOKEN=
GITHUB_REPOSITORY=
GITHUB_API_URL=

# Legacy Google Sheets vars still accepted by test.sh (schedule action is not supported by this Action)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_NAME=
